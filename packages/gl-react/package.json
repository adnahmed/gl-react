{
  "name": "gl-react",
  "version": "5.2.0",
  "license": "MIT",
  "author": "Gaëtan Renaudeau <renaudeau.gaetan@gmail.com>",
  "description": "Universal React library, write and compose WebGL shaders, implement complex effects using a descriptive paradigm",
  "keywords": [
    "gl-react",
    "gl",
    "opengl",
    "react",
    "react-component"
  ],
  "main": "lib/index.js",
  "files": [
    "src",
    "lib",
    "flow",
    ".flowconfig",
    "README.md",
    "LICENSE",
    "gl-react.js"
  ],
  "browserify-shim": {
    "react": "global:React"
  },
  "peerDependencies": {
    "react": "*"
  },
  "dependencies": {
    "gl-shader": "^4.3.1",
    "invariant": "^2.2.4",
    "ndarray": "^1.0.19",
    "prop-types": "^15.7.2",
    "typedarray-pool": "^1.2.0",
    "webgltexture-loader": "2.0.0",
    "webgltexture-loader-ndarray": "2.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.13.10",
    "@babel/plugin-proposal-class-properties": "^7.13.0",
    "@babel/plugin-proposal-object-rest-spread": "^7.13.8",
    "@babel/preset-env": "^7.13.10",
    "@babel/preset-flow": "^7.12.13",
    "@babel/preset-react": "^7.12.13",
    "browserify": "^17.0.0",
    "browserify-shim": "^3.8.12",
    "flow-copy-source": "^2.0.9"
  },
  "scripts": {
    "babel": "babel --root-mode upward --source-maps -d lib src && flow-copy-source src lib",
    "browserify": "browserify lib/index.js -t [ browserify-shim ] --standalone GLReact > gl-react.js",
    "build": "npm run babel && npm run browserify",
    "prepare": "npm run build"
  },
  "gitHead": "9adf91601b95aec6dcd350179fdbd139a97bed5e"
}